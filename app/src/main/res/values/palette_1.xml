<resources>
 <style name="PaletteTheme1" parent="android:style/Theme.Material.NoActionBar">
  <item name="android:fontFamily">sans</item><item name="android:colorAccent">#5AE594</item>
  <item name="android:textColorPrimary">#E9F8EF</item><item name="android:textColorSecondary">#9BBAA8</item>
  <item name="android:windowLightStatusBar">false</item><item name="android:statusBarColor">#08150D</item>
  <item name="android:navigationBarColor">#08150D</item><item name="android:windowLightNavigationBar">false</item>
  <item name="android:windowActionModeOverlay">true</item><item name="android:windowBackground">#08150D</item>
  <item name="android:alertDialogTheme">@style/PaletteDialog1</item><item name="android:colorControlNormal">#9BBAA8</item>
 </style>
 <style name="PaletteDialog1" parent="android:style/Theme.Material.Dialog.Alert">
  <item name="android:windowBackground">@drawable/soft_dialog_background_p1</item><item name="android:colorAccent">#5AE594</item>
  <item name="android:textColorPrimary">#E9F8EF</item><item name="android:textColorSecondary">#9BBAA8</item>
  <item name="android:fontFamily">sans</item><item name="android:backgroundDimAmount">0.56</item>
  <item name="android:windowAnimationStyle">@style/PaletteMotion1</item>
  <item name="android:windowMinWidthMajor">94%</item><item name="android:windowMinWidthMinor">94%</item>
  <item name="android:buttonBarPositiveButtonStyle">@style/PalettePositive1</item><item name="android:buttonBarNegativeButtonStyle">@style/PaletteSecondary1</item><item name="android:buttonBarNeutralButtonStyle">@style/PaletteSecondary1</item>
 </style>
 <style name="PalettePositive1" parent="android:style/Widget.Material.Button.Borderless">
  <item name="android:stateListAnimator">@animator/deck_button_press</item><item name="android:background">@drawable/soft_action_p1</item><item name="android:textColor">#092B17</item>
  <item name="android:minHeight">44dp</item><item name="android:minWidth">88dp</item><item name="android:paddingLeft">16dp</item><item name="android:paddingRight">16dp</item>
 </style>
 <style name="PaletteSecondary1" parent="PalettePositive1"><item name="android:background">@drawable/soft_secondary_p1</item><item name="android:textColor">#E7F8EE</item></style>
 <style name="PaletteMotion1"><item name="android:windowEnterAnimation">@anim/soft_dialog_enter</item><item name="android:windowExitAnimation">@anim/soft_dialog_exit</item></style>
</resources>
