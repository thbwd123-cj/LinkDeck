<resources>
 <style name="PaletteTheme4" parent="android:style/Theme.Material.NoActionBar">
  <item name="android:fontFamily">sans</item>
  <item name="android:colorAccent">#006B60</item>
  <item name="android:textColorPrimary">#172B3A</item>
  <item name="android:textColorSecondary">#435765</item>
  <item name="android:windowLightStatusBar">true</item>
  <item name="android:statusBarColor">#F4F7FA</item>
  <item name="android:navigationBarColor">#F4F7FA</item>
  <item name="android:windowLightNavigationBar">true</item>
  <item name="android:windowActionModeOverlay">true</item>
  <item name="android:windowBackground">#F4F7FA</item>
  <item name="android:alertDialogTheme">@style/PaletteDialog4</item>
  <item name="android:colorControlNormal">#435765</item>
 </style>
 <style name="PaletteDialog4" parent="android:style/Theme.Material.Dialog.Alert">
  <item name="android:windowBackground">@drawable/soft_dialog_background_p4</item>
  <item name="android:colorAccent">#006B60</item>
  <item name="android:textColorPrimary">#172B3A</item>
  <item name="android:textColorSecondary">#435765</item>
  <item name="android:fontFamily">sans</item>
  <item name="android:backgroundDimAmount">0.56</item>
  <item name="android:windowAnimationStyle">@style/PaletteMotion4</item>
  <item name="android:windowMinWidthMajor">94%</item>
  <item name="android:windowMinWidthMinor">94%</item>
  <item name="android:buttonBarPositiveButtonStyle">@style/PalettePositive4</item>
  <item name="android:buttonBarNegativeButtonStyle">@style/PaletteSecondary4</item>
  <item name="android:buttonBarNeutralButtonStyle">@style/PaletteSecondary4</item>
 </style>
 <style name="PalettePositive4" parent="android:style/Widget.Material.Button.Borderless">
  <item name="android:stateListAnimator">@animator/deck_button_press</item>
  <item name="android:background">@drawable/soft_action_p4</item>
  <item name="android:textColor">#172B3A</item>
  <item name="android:minHeight">44dp</item>
  <item name="android:minWidth">88dp</item>
  <item name="android:paddingLeft">16dp</item>
  <item name="android:paddingRight">16dp</item>
 </style>
 <style name="PaletteSecondary4" parent="PalettePositive4">
  <item name="android:background">@drawable/soft_secondary_p4</item>
  <item name="android:textColor">#172B3A</item>
 </style>
 <style name="PaletteMotion4">
  <item name="android:windowEnterAnimation">@anim/soft_dialog_enter</item>
  <item name="android:windowExitAnimation">@anim/soft_dialog_exit</item>
 </style>
</resources>