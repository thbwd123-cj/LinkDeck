<resources>
 <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
  <item name="android:fontFamily">sans</item><item name="android:colorAccent">#49E2CD</item>
  <item name="android:textColorPrimary">#EFF5FF</item><item name="android:textColorSecondary">#A6B4C8</item>
  <item name="android:windowLightStatusBar">false</item><item name="android:statusBarColor">#0B131E</item>
  <item name="android:navigationBarColor">#0B131E</item><item name="android:windowLightNavigationBar">false</item>
  <item name="android:windowActionModeOverlay">true</item><item name="android:windowBackground">#0B131E</item>
  <item name="android:alertDialogTheme">@style/SoftDialog</item><item name="android:colorControlNormal">#A6B4C8</item>
 </style>
 <style name="SoftDialog" parent="android:style/Theme.Material.Dialog.Alert">
  <item name="android:windowBackground">@drawable/soft_dialog_background</item><item name="android:colorAccent">#49E2CD</item>
  <item name="android:textColorPrimary">#EFF5FF</item><item name="android:textColorSecondary">#A6B4C8</item>
  <item name="android:fontFamily">sans</item><item name="android:backgroundDimAmount">0.56</item>
  <item name="android:windowAnimationStyle">@style/SoftDialogMotion</item>
  <item name="android:windowMinWidthMajor">94%</item><item name="android:windowMinWidthMinor">94%</item>
  <item name="android:buttonBarPositiveButtonStyle">@style/SoftPositive</item><item name="android:buttonBarNegativeButtonStyle">@style/SoftSecondary</item><item name="android:buttonBarNeutralButtonStyle">@style/SoftSecondary</item>
 </style>
 <style name="SoftPositive" parent="android:style/Widget.Material.Button.Borderless">
  <item name="android:stateListAnimator">@animator/deck_button_press</item><item name="android:background">@drawable/soft_action</item><item name="android:textColor">#072A2A</item>
  <item name="android:minHeight">44dp</item><item name="android:minWidth">88dp</item><item name="android:paddingLeft">16dp</item><item name="android:paddingRight">16dp</item>
 </style>
 <style name="SoftSecondary" parent="SoftPositive"><item name="android:background">@drawable/soft_secondary</item><item name="android:textColor">#EDF5FF</item></style>
 <style name="SoftDialogMotion"><item name="android:windowEnterAnimation">@anim/soft_dialog_enter</item><item name="android:windowExitAnimation">@anim/soft_dialog_exit</item></style>
</resources>
